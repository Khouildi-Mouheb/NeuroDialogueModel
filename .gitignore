# Publish only model/, README.md and .gitignore; everything else at the root stays local.
/*
!/model/
!/README.md
!/.gitignore
!/requirements.txt

# Secrets / environment
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Databases & vector store
*.sqlite3
*.sqlite
*.db
model/adapters/retrieval/stores/chroma_store/

# Saved models
my_saved_models/

# Runtime logs (conversation exports may contain user data)
*.log
model/logs/
